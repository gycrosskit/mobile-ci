<?xml version='1.1' encoding='UTF-8'?>
<!-- 分支/Tag 选择器由 generate_jenkins_job_templates.py 从 jenkins/selectors/ 生成，请修改规范文本。 -->
<flow-definition plugin="workflow-job">
  <actions/>
  <description>HarmonyOS QA/Debug 测试包（默认 QA，测试 API、诊断开启）：构建、只读签名和严格验签；默认 UPLOAD_AND_NOTIFY=true：HAP 与同源 P12/密码完整分发并验收后发送通知；关闭时仅验证，不上传、不读取通知凭据。官方 Linux SDK 的 linux-build 节点使用 4 GiB Gradle、1 GiB Node 和 4 GiB LLVM/原生余量，总预算至少 9 GiB。可用物理内存与允许的剩余 swap 同时受宿主及 cgroup memory/memsw 限制，禁用或未核实的 swap 不计入。</description>
  <displayName>鸿蒙 QA 测试包</displayName>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.ChoiceParameterDefinition>
          <name>BRAND</name>
          <description>已登记独立 HarmonyOS 应用的品牌；材料验收前 signing.enabled=false 会阻断构建。</description>
          <!-- 由 generate_jenkins_job_templates.py 根据 ci/brands.json 的 harmony 配置维护。 -->
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>cihang</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.ChoiceParameterDefinition>
          <name>BUILD_TYPE</name>
          <description>默认 QA：Release 优化；可选 Debug：调试编译。二者均为测试 API、诊断开启，使用指定设备签名。</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>QA</string>
              <string>Debug</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.ChoiceParameterDefinition>
          <name>BRANCH_TYPE</name>
          <description>选择要构建的分支类型，分支下拉框会自动联动刷新。</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>feature</string>
              <string>dev</string>
              <string>release</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <org.biouno.unochoice.CascadeChoiceParameter plugin="uno-choice">
          <name>GIT_BRANCH</name>
          <description>只显示所选品牌和类型的远程分支，可输入关键字继续过滤。</description>
          <randomName>choice-parameter-ohos-git-branch</randomName>
          <visibleItemCount>1</visibleItemCount>
          <script class="org.biouno.unochoice.model.GroovyScript">
            <secureScript>
              <script>import net.uaznia.lukanus.hudson.plugins.gitparameter.GitParameterDefinition
import net.uaznia.lukanus.hudson.plugins.gitparameter.SelectedValue
import net.uaznia.lukanus.hudson.plugins.gitparameter.jobs.JobWrapperFactory
import jenkins.model.Jenkins

def jobName = '__JOB_NAME__'
// 品牌白名单由 generate_jenkins_job_templates.py 生成，避免参数页和 ci/brands.json 漂移。
def allowedBrands = ['cihang']
def brand = 'cihang'
def branchType = 'feature'
try {
    brand = BRAND?.toString() ?: brand
} catch (MissingPropertyException ignored) {
    // 首次渲染参数页时，Active Choices 可能尚未注入引用参数。
}
try {
    branchType = BRANCH_TYPE?.toString() ?: branchType
} catch (MissingPropertyException ignored) {
    // 保持界面中两个 Choice 参数的默认值。
}
if (!allowedBrands.contains(brand)) {
    return ['请先选择品牌:selected']
}
def job = Jenkins.get().getItemByFullName(jobName)
if (job == null) {
    return ['测试任务不存在:selected']
}
job.checkPermission(hudson.model.Item.BUILD)
def parameter = new GitParameterDefinition(
    'DISCOVERED_BRANCH',
    'PT_BRANCH',
    '',
    '',
    '',
    'origin/(.*)',
    '*',
    null,
    SelectedValue.NONE,
    '{{CI_APP_REPO_PATTERN}}',
    false
)
def wrapper = JobWrapperFactory.createJobWrapper(job)
def scm = new hudson.plugins.git.GitSCM(
    [new hudson.plugins.git.UserRemoteConfig('{{CI_APP_SSH}}', 'origin', '+refs/heads/*:refs/remotes/origin/*', '{{CI_CREDENTIAL_SCM}}')],
    [], null, null, []
)
def branches = parameter.generateContents(wrapper, [scm]).values.collect { org.biouno.unochoice.util.SafeHtmlExtendedMarkupFormatter.INSTANCE.translate(it.value.toString()) }

if (branchType == 'feature') {
    branches = branches.findAll { it.startsWith("feature/${brand}/") }
} else if (branchType == 'dev') {
    branches = branches.findAll { it == "dev/${brand}" }
} else if (branchType == 'release') {
    branches = branches.findAll { it.startsWith("release/${brand}-") }
} else {
    return ['请先选择分支类型:selected']
}

return branches.sort() ?: ['该类型暂无远程分支:selected']</script>
              <sandbox>false</sandbox>
            </secureScript>
            <secureFallbackScript>
              <script>return ['分支加载失败，请联系 Jenkins 管理员:selected']</script>
              <sandbox>true</sandbox>
            </secureFallbackScript>
          </script>
          <projectName>__JOB_NAME__</projectName>
          <projectFullName>__JOB_NAME__</projectFullName>
          <parameters class="linked-hash-map"/>
          <referencedParameters>BRAND,BRANCH_TYPE</referencedParameters>
          <choiceType>PT_SINGLE_SELECT</choiceType>
          <filterable>true</filterable>
          <filterLength>1</filterLength>
        </org.biouno.unochoice.CascadeChoiceParameter>
        <hudson.model.BooleanParameterDefinition>
          <name>UPLOAD_AND_NOTIFY</name>
          <description>true 上传并通知；false 只验证构建和签名，不上传、不读取通知凭据。</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs><hudson.plugins.git.UserRemoteConfig>
        <url>{{CI_CI_CHECKOUT_URL}}</url>
        <credentialsId>{{CI_CI_CHECKOUT_CREDENTIAL}}</credentialsId>
      </hudson.plugins.git.UserRemoteConfig></userRemoteConfigs>
      <branches><hudson.plugins.git.BranchSpec><name>__CI_AUTOMATION_COMMIT__</name></hudson.plugins.git.BranchSpec></branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>jenkins/Jenkinsfile.ohos.test</scriptPath>
    <lightweight>false</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
