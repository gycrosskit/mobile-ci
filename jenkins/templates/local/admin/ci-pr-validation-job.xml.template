<flow-definition plugin="workflow-job">
  <actions />
  <description>CI 仓库 MR 门禁：固定 Pipeline 文本，检出预合并提交，仅执行测试及模板契约；不加载 MR Pipeline，不绑定发布凭据、不部署或合并。</description>
  <displayName>CI 仓库 MR 验证</displayName>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>30</daysToKeep>
        <numToKeep>80</numToKeep>
        <artifactDaysToKeep>30</artifactDaysToKeep>
        <artifactNumToKeep>30</artifactNumToKeep>
        <removeLastBuild>false</removeLastBuild>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition"><script>__CI_PR_VALIDATION_PIPELINE__</script><sandbox>true</sandbox></definition>
  <triggers />

  <disabled>true</disabled>
</flow-definition>
