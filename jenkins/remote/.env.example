# 默认仅绑定回环地址；固定 IP 直连模式需显式改为 0.0.0.0，并接受明文 HTTP 风险。
JENKINS_HTTP_HOST=127.0.0.1
JENKINS_HTTP_PORT=18080

# 自动创建的 Linux Android 节点。
JENKINS_AGENT_NAME=linux-build
JENKINS_AGENT_LABELS=android-builder ohos-linux linux-build
JENKINS_PR_AGENT_NAME=pr-linux
JENKINS_AI_REVIEW_AGENT_NAME=ai-review-linux

# 仅供 public.sh 使用；Authtoken 和 OAuth 白名单保存在 runtime/，不写入此文件。
NGROK_DOMAIN=replace-with-reserved-domain.ngrok-free.app
NGROK_UID=1000
NGROK_GID=1000
